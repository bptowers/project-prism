# Project Prism - Environment Configuration
# Copy to .env.local and fill in your values

# LLM Provider Configuration
# Options: claude, gemini, openai
LLM_PROVIDER=claude

# API Keys
# Claude: Get from https://console.anthropic.com/
LLM_API_KEY=sk-ant-your-api-key-here

# Model Selection
# Claude: claude-3-5-sonnet-20241022 (recommended), claude-3-5-haiku-20241022
# Gemini: gemini-2.0-flash, gemini-1.5-pro
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=claude-3-5-sonnet-20241022

# Temperature (0-2, lower = more deterministic)
LLM_TEMPERATURE=0.3

# Max output tokens
LLM_MAX_TOKENS=2000

# Top-P (nucleus sampling)
LLM_TOP_P=0.9

# Frequency penalty (OpenAI)
LLM_FREQUENCY_PENALTY=0

# Presence penalty (OpenAI)
LLM_PRESENCE_PENALTY=0

# Google Cloud Configuration (for Gemini provider)
GCP_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Pipeline Configuration
BATCH_SIZE=25
MAX_RETRIES=3
RETRY_DELAY_MS=1000
ENABLE_PII_SCRUBBING=true
CONFIDENCE_THRESHOLD=0.5

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=project-prism-uploads.appspot.com

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_VALIDATION_LOGGING=true
ENABLE_DETAILED_ANALYTICS=true
ENABLE_PII_DETECTION=true
