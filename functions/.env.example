# Copy this file to functions/.env and fill in the values.
# In PRODUCTION the LLM API keys are NOT read from here — they come from Firebase
# Secret Manager (each function declares secrets: ["ANTHROPIC_API_KEY", ...]).
# This .env is for local development / emulator runs only. Never commit real keys.

# --- LLM provider selection -------------------------------------------------
# Which provider the pipeline uses. Options: claude | gemini | openai
LLM_PROVIDER=gemini

# API keys. Only the selected provider's key is required. Each is also readable
# via the LLM_API_KEY fallback if you prefer a single generic var.
ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# Per-provider model overrides (defaults shown; set in index.ts getLLMConfig).
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o
# Generic fallback if the per-provider var above is unset.
LLM_MODEL=claude-sonnet-4-6

# --- LLM tuning -------------------------------------------------------------
LLM_TEMPERATURE=0.3

# Output-token cap. Gemini 2.5's hidden "thinking" tokens count against this,
# so keep it generous — too low and the enrichment-phase JSON truncates and the
# phase is silently skipped. Production sets 65536.
LLM_MAX_TOKENS=16384

# Global cap on simultaneous per-deal LLM calls (single limiter across the run).
# Wall-clock scales roughly inversely with this; keep a full run inside the 540s
# function timeout. Default in code is 25; production .env uses 40.
LLM_CONCURRENCY=40

# --- BigQuery data source (cross-project; required for fetchFromBigQuery) ----
# Get these from the BigQuery data-warehouse owner.
BQ_PROJECT_ID=<data-warehouse-project-id>
BQ_DATASET=<dataset-name>
BQ_TABLE=<table-name>
BQ_LOCATION=US
