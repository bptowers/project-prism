# Copy this to .env and fill in your API key
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-5-20250929
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3
# Gemini 2.5 uses hidden thinking tokens (~2-3K each) that count toward max
# output. Observed truncations at 8192; raised to 16384 for safety margin.
LLM_MAX_TOKENS=16384

# BigQuery Data Source (cross-project)
# Get these values from your BigQuery data warehouse engineer
BQ_PROJECT_ID=<data-warehouse-project-id>
BQ_DATASET=<dataset-name>
BQ_TABLE=<table-name>
BQ_LOCATION=US
