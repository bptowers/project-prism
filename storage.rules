rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Access is restricted to verified company-domain Google accounts.
    // Domain allowlist is duplicated in 4 places (keep in sync):
    // hosting/src/lib/allowedDomains.ts, functions/src/util/allowedDomains.ts,
    // firestore.rules, storage.rules (here).
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('(?i).*@(simprogroup[.]com|simpro[.]us|simpro[.]au|bigchange[.]com)');
    }

    match /uploads/{fileName} {
      // Uploaded CSVs contain pipeline/deal data — company-domain sign-in required.
      allow read: if allowed();
      allow write: if allowed()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('text/csv');
    }
    match /reports/{fileName} {
      allow read: if allowed();
      allow write: if false;
    }
  }
}
