rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Access is restricted to verified company-domain Google accounts.
    // Domain allowlist is duplicated in 4 places (keep in sync):
    // hosting/src/lib/allowedDomains.ts, functions/src/util/allowedDomains.ts,
    // firestore.rules (here), storage.rules.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('(?i).*@(simprogroup[.]com|simpro[.]us|simpro[.]au|bigchange[.]com)');
    }

    // Reports — company-domain sign-in required
    match /reports/{reportId} {
      allow read: if allowed();
      allow write: if false; // Only Cloud Functions write (Admin SDK bypasses rules)
    }
    // Deals subcollection — individual deal records served separately to bypass 1 MiB doc limit
    match /reports/{reportId}/deals/{dealId} {
      allow read: if allowed();
      allow write: if false;
    }
    // Analyses — company-domain sign-in required
    match /analyses/{analysisId}/{document=**} {
      allow read: if allowed();
      allow write: if false;
    }
    // Config — readable by allowed users, writable by admins only
    match /config/{configId} {
      allow read: if allowed();
      allow write: if request.auth.token.admin == true;
    }
    // Shared deal reviews: the ONLY client-writable path. A user may stamp
    // a review with their own email only, server time only, fixed fields only.
    match /dealReviews/{dealKey} {
      allow read: if allowed();
      allow create, update: if allowed()
        && request.resource.data.keys().hasOnly(['reviewedBy', 'reviewedByName', 'reviewedAt', 'riskAtReview'])
        && request.resource.data.keys().hasAll(['reviewedBy', 'reviewedByName', 'reviewedAt', 'riskAtReview'])
        && request.resource.data.reviewedBy == request.auth.token.email
        && request.resource.data.reviewedByName is string
        && request.resource.data.reviewedByName.size() <= 200
        && request.resource.data.reviewedByName == request.auth.token.get('name', request.auth.token.email)
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.riskAtReview is number
        && request.resource.data.riskAtReview >= 0
        && request.resource.data.riskAtReview <= 100;
      allow delete: if allowed();
    }
  }
}
